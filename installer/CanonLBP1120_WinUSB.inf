; ==============================================================================
; Canon LaserShot LBP-1120 WinUSB Driver Installation INF
; Supported OS: Windows 10 (x86, x64, ARM64), Windows 11 (x64, ARM64)
; Hardware ID: USB\VID_04A9&PID_262B
; Interface GUID: {F9A25620-E255-4B37-93F3-0C3D3D2DFBD3}
; ==============================================================================

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
DriverVer   = 10/31/2026, 1.0.0.0
CatalogFile = CanonLBP1120_WinUSB.cat

[Manufacturer]
%ManufacturerName% = Standard,NTamd64,NTx86,NTarm64

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_04A9&PID_262B

[Standard.NTx86]
%DeviceName% = USB_Install, USB\VID_04A9&PID_262B

[Standard.NTarm64]
%DeviceName% = USB_Install, USB\VID_04A9&PID_262B

; =================== Installation Sections ===================

[USB_Install]
Include = winusb.inf
Needs   = WinUSB.NT

[USB_Install.Services]
Include = winusb.inf
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName     = %WinUSB_SvcDesc%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

[USB_Install.Wdf]
KmdfService = WINUSB, WinUSB_Install

[WinUSB_Install]
KmdfLibraryVersion = 1.11

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
; WinUSB device interface GUID queried by capt-poc / UsbPrinter::find_and_open()
HKR,,DeviceInterfaceGUIDs,0x10000,"{F9A25620-E255-4B37-93F3-0C3D3D2DFBD3}"

; =================== Strings ===================

[Strings]
ProviderName     = "Canon LBP-1120 Open Engineering"
ManufacturerName = "Canon (Open Driver Ecosystem)"
DeviceName       = "Canon LaserShot LBP-1120 (WinUSB Interface)"
WinUSB_SvcDesc   = "WinUSB Driver Service"

